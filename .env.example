# Optional. Without it the intake still works, but falls back to
# rule-based extraction instead of the model.
ANTHROPIC_API_KEY=

# Shared token guarding /dispatch and the booking API. Required in
# production — without it the dispatch side refuses to serve, because it
# exposes customer names, phone numbers and addresses.
DISPECR_DISPATCH_TOKEN=

# Optional override for the SQLite file location.
# DISPECR_DB=./data/dispecr.db
